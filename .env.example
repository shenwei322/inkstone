# ===== InkStone 生产环境变量 =====
# 用法：复制为 .env 填好真实值，然后：
#   docker compose --env-file .env -f docker-compose.prod.yml up -d --build

# —— 数据库 / 后端（务必修改）——
DB_USER=blog
DB_PASSWORD=change_me_strong_password
DB_NAME=blog_platform
JWT_SECRET=change_me_64_char_random_string
APP_ENV=production

# —— 对外地址（改成你的域名）——
FRONTEND_URL=https://blog.shenv.top
# 封面/文件访问前缀。设为绝对域名，next/image 优化才能跨容器取到图；反代同源场景可留空
PUBLIC_API_URL=https://blog.shenv.top

# —— 前端（构建期注入，修改后必须重新 build 前端镜像）——
NEXT_PUBLIC_API_URL=https://blog.shenv.top/api/v1

# —— 监听绑定（默认仅本机，由 Nginx 对外）——
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

# —— 可信反向代理（决定 X-Forwarded-For 是否被采信）——
# 只有「直连对端」落在这里列出的网段内，后端才会采信 X-Forwarded-For /
# X-Real-IP 来判定访客 IP；否则一律用 TCP 对端地址。
#
# 为什么必须收紧：gin 默认信任所有代理，任何能直连后端的客户端只要每次
# 请求换一个 X-Forwarded-For 值，就能绕过全部 IP 限流（登录/注册/评论/
# 人机验证签发），实测可 200/200 全放行。
#
# 留空 = 默认值，包含本机与私网（127.0.0.0/8、10/8、172.16/12、
# 192.168/16、::1、fc00::/7），覆盖「同机 / 同 compose 网络的 Nginx」。
# 反代在另一台机器（走公网 IP 连过来）时必须显式写它的地址，例如：
#   TRUSTED_PROXIES=203.0.113.9/32
# 显式写 none 表示不信任任何代理（直连部署下最安全）。
# TRUSTED_PROXIES=

# —— 在线更新系统（后台 → 系统更新）——
# 更新 = 下载上游源码镜像包 → 校验 → 备份 → 替换源码 → 重建重启。
# 容器内的后端没有 docker 权限，重建由宿主更新代理完成：
#   deploy/update-agent.sh（Linux，建议 systemd 常驻） / deploy/update-agent.ps1（Windows）
UPDATE_ENABLED=true
UPDATE_REPO_URL=https://github.com/shenwei234/inkstone
UPDATE_BRANCH=main
# 更新源：commits（默认，对比提交+下载源码包） / releases（GitHub Releases + 镜像包）
# releases 模式下上游只需发布 Release：tag 用语义化版本（v1.28.0），
# 资产里放镜像包（默认匹配 inkstone-images-*.tar），安装动作是 docker load + compose up -d
# UPDATE_SOURCE=releases
# Releases 接口模板（默认 {UPDATE_GITHUB_API}/repos/{owner}/{name}/releases/latest）
# UPDATE_RELEASES_API=https://api.github.com/repos/{owner}/{name}/releases/latest
# 镜像包资产名匹配（正则；多个命中时优先版本号出现在文件名里的）
# UPDATE_IMAGE_ASSET=inkstone-images-.*\.tar$
# 镜像包大小上限 MB（前后端两个镜像一般 <1GB，默认 2048）
# UPDATE_IMAGE_MAX_MB=2048
# 镜像更新使用的 compose 文件（默认自动探测 offline → prod → .yml）
# UPDATE_COMPOSE_FILE=docker-compose.offline.yml
# 部署版本记录（镜像部署没有 commit，用版本号记录；默认自动探测 data/deployed-version.json）
# UPDATE_VERSION_FILE=/app/data/deployed-version.json
# 源码包镜像（{owner} {name} {commit} {branch} {short} 占位）；国内建议保留代理地址
UPDATE_MIRROR=https://gh-proxy.com/https://github.com/{owner}/{name}/archive/{commit}.tar.gz
# 私有仓库填 token（公开仓库留空）
# UPDATE_TOKEN=
# 自建更新服务器（可选，配了就不走 GitHub API）
# UPDATE_LATEST_API=https://example.com/inkstone/latest.json
# UPDATE_COMMITS_API=https://example.com/inkstone/commits?branch={branch}&limit={limit}&page={page}
# UPDATE_COMPARE_API=https://example.com/inkstone/compare?from={from}&to={to}
# 待替换的源码目录（容器内路径；需把宿主源码目录挂进容器，见 .ai-skill/references/deployment.md）
# UPDATE_SOURCE_DIR=/app/src
# 更新工作目录（默认在数据卷内：/app/data/update），宿主代理要从这里读待更新清单
# UPDATE_DIR=/app/data/update
# 部署记录文件（默认自动探测 data/deployed-commit.json）
# UPDATE_DEPLOYED_FILE=/app/data/deployed-commit.json
# 更新目录里没有 git 时，也可让宿主代理用 git remote 名回退（代理脚本使用）
# UPDATE_REMOTE=origin
# true=替换源码后等宿主代理重建（容器部署默认）；false=后端自己 docker compose/本机编译
UPDATE_WAITING_AGENT=true

# —— 可选：应急全局停用验证码 ——
# INKSTONE_DISABLE_CAPTCHA=1
